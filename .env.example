# All keys are optional. The app works with only the free, keyless sources
# (Sleeper, ESPN, FantasyCalc, DynastyProcess, nflverse — which already provides
# Vegas spreads/totals and implied team totals for every game).

# The Odds API (https://the-odds-api.com) — Vegas PLAYER PROPS. The free tier is 500
# credits/month. Props are only pulled when you click "Pull Vegas props" in Line-Up Guru
# (cost = games x markets, shown before you click); page loads never spend credits.
ODDS_API_KEY=

# Which games to pull props for: mine (your team + this week's opponent, default),
# league (any rostered player), or all.
# ODDS_PROPS_SCOPE=mine

# Which markets (each costs 1 credit per game). Default: the 4 highest-signal markets.
# Options: player_pass_yds,player_pass_tds,player_pass_interceptions,player_rush_yds,
#          player_receptions,player_reception_yds,player_anytime_td
# ODDS_PROP_MARKETS=player_pass_yds,player_rush_yds,player_reception_yds,player_anytime_td

# FantasyPros API (https://api.fantasypros.com): weekly expert consensus rankings (ECR).
FANTASYPROS_API_KEY=

# Optional: override cache TTL (minutes) for all upstream responses.
# CACHE_TTL_MINUTES=
