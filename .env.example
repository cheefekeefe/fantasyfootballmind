# All keys are optional. The app works with only the free, keyless sources
# (Sleeper, FantasyCalc, DynastyProcess, nflverse). Each key unlocks another source.

# The Odds API (https://the-odds-api.com): Vegas game lines + player props.
# The free tier (500 credits/mo) covers game lines; player props cost ~1 credit
# per market per game, so a paid tier is recommended for weekly prop pulls.
ODDS_API_KEY=

# FantasyPros API (https://api.fantasypros.com): weekly/ROS expert consensus rankings (ECR).
FANTASYPROS_API_KEY=

# Optional: how long (minutes) to cache upstream responses. Default values per source are sensible.
# CACHE_TTL_MINUTES=
